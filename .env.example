# ----------------------------------------------------------------------------
# Web Monitor - example environment file
# Copy to .env  ->  cp .env.example .env
# NEVER commit .env (it is in .gitignore)
# ----------------------------------------------------------------------------

# --- HTTP server ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# SQLite file used for local development.
DATABASE_FILE=./data/web-monitor.sqlite

# --- Authentication (dashboard login) ---------------------------------------
# local    -> a single admin, credentials below (default)
# supabase -> real users with email + password, managed by Supabase Auth
AUTH_PROVIDER=local
ADMIN_USERNAME=admin
# Preferred: a scrypt hash generated with `npm run hash-password -- "yourPassword"`
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<hash>
# Development fallback (hashed in memory at boot, never stored in plain text).
ADMIN_PASSWORD=change-me-please
# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Session lifetime in seconds (default 8 hours)
SESSION_TTL=28800
# Set to true when serving the dashboard over HTTPS (secure cookies)
SECURE_COOKIES=false

# --- Supabase (only when AUTH_PROVIDER=supabase) ----------------------------
# Project settings -> API
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...            # public by design, used by the browser
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...    # SECRET: enables the "Usuarios" section
# Optional but recommended: with it the tokens are verified locally (HS256,
# no network). Project settings -> API -> JWT Settings. Without it the app
# falls back to asking Supabase who the token belongs to, caching the answer.
# SUPABASE_JWT_SECRET=

# --- Base de datos (Supabase) -----------------------------------------------
# La UNICA variable que hace falta para la base de datos. Sin ella el proyecto
# usa SQLite en local; con ella usa Postgres (Supabase) en todas partes.
# Se copia de: Supabase -> Project Settings -> Database -> Connection string.
#
#   Transaction pooler (puerto 6543) -> es la que hay que usar en Netlify,
#   porque una funcion serverless abre y cierra conexiones todo el rato.
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
#   Direct connection (puerto 5432) -> vale para ejecutar migraciones a mano.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres
#
# El esquema se aplica solo en el primer arranque. Para hacerlo a mano:
#   DATABASE_URL=... npm run migrate:pg

# --- Analisis con Claude ----------------------------------------------------
# La clave con la que Claude decide QUE ha cambiado y si importa. Sin ella el
# sistema sigue rastreando y guardando versiones, pero no clasifica nada y el
# informe sale sin redactar.
#
# Coste: un dia sin cambios no cuesta nada (no hay llamada). Un dia normal son
# unas pocas llamadas de unos miles de tokens, porque a Claude solo le llega el
# diff de las paginas que se movieron, no las webs enteras.
# El modelo se cambia desde el dashboard (ajuste "analysis_model"):
#   claude-opus-5     por defecto, mejor criterio
#   claude-haiku-4-5  aproximadamente un quinto del gasto
# ANTHROPIC_API_KEY=sk-ant-...

# --- Crawler / scheduler ----------------------------------------------------
# How often the scheduler wakes up to look for websites that are due (seconds).
# Initial default only: once the database exists, this value lives in Settings
# (dashboard -> Configuracion) and the dashboard value wins.
SCHEDULER_TICK=15
# Maximum number of websites checked in parallel. Same rule: after the first
# boot it is managed from the dashboard.
CRAWLER_CONCURRENCY=8
# Per-request timeout in milliseconds.
CRAWLER_TIMEOUT_MS=20000
# User-Agent sent by the crawler.
CRAWLER_USER_AGENT=WebMonitorBot/1.0 (+https://example.com/bot)
# Run the scheduler inside the web server process (true) or only as the
# standalone `npm run crawler` process (false).
RUN_SCHEDULER_IN_WEB=true

# --- Email (SMTP) -----------------------------------------------------------
# transport: smtp | console  (console prints emails to stdout, useful in dev)
MAIL_TRANSPORT=console
MAIL_FROM="Web Monitor <monitor@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional: public base URL of the dashboard, used in email footers.
APP_BASE_URL=http://localhost:3000

# --- Seed data --------------------------------------------------------------
# The watched websites live in src/config/sites.js and are published into the
# database on every boot; set this to false for an empty install (the tests do).
SEED_WATCHED_SITES=true
# How often a newly published site is due for a check, in seconds.
SEED_WEBSITE_INTERVAL=21600
# The first worker, inserted only while the workers table is still empty.
SEED_WORKER_NAME=Test Worker
SEED_WORKER_EMAIL=cruecrv9445@gmail.com
