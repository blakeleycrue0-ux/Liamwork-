# ----------------------------------------------------------------------------
# Web Monitor - example environment file
# Copy to .env  ->  cp .env.example .env
# NEVER commit .env (it is in .gitignore)
# ----------------------------------------------------------------------------

# --- HTTP server ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# SQLite file used for local development.
DATABASE_FILE=./data/web-monitor.sqlite

# --- Authentication (dashboard login) ---------------------------------------
# local    -> a single admin, credentials below (default)
# supabase -> real users with email + password, managed by Supabase Auth
AUTH_PROVIDER=local
ADMIN_USERNAME=admin
# Preferred: a scrypt hash generated with `npm run hash-password -- "yourPassword"`
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<hash>
# Development fallback (hashed in memory at boot, never stored in plain text).
ADMIN_PASSWORD=change-me-please
# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Session lifetime in seconds (default 8 hours)
SESSION_TTL=28800
# Set to true when serving the dashboard over HTTPS (secure cookies)
SECURE_COOKIES=false

# --- Supabase (only when AUTH_PROVIDER=supabase) ----------------------------
# Project settings -> API
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...            # public by design, used by the browser
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...    # SECRET: enables the "Usuarios" section
# Legacy projects sign tokens with HS256 and a shared secret; newer ones use
# asymmetric keys and are verified through JWKS (no value needed here).
# SUPABASE_JWT_SECRET=

# Postgres connection (Supabase, Neon, RDS...). When set, the app uses Postgres
# instead of SQLite. Apply the schema once with: npm run migrate:pg
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# --- Crawler / scheduler ----------------------------------------------------
# How often the scheduler wakes up to look for websites that are due (seconds).
# Initial default only: once the database exists, this value lives in Settings
# (dashboard -> Configuracion) and the dashboard value wins.
SCHEDULER_TICK=15
# Maximum number of websites checked in parallel. Same rule: after the first
# boot it is managed from the dashboard.
CRAWLER_CONCURRENCY=8
# Per-request timeout in milliseconds.
CRAWLER_TIMEOUT_MS=20000
# User-Agent sent by the crawler.
CRAWLER_USER_AGENT=WebMonitorBot/1.0 (+https://example.com/bot)
# Run the scheduler inside the web server process (true) or only as the
# standalone `npm run crawler` process (false).
RUN_SCHEDULER_IN_WEB=true

# --- Email (SMTP) -----------------------------------------------------------
# transport: smtp | console  (console prints emails to stdout, useful in dev)
MAIL_TRANSPORT=console
MAIL_FROM="Web Monitor <monitor@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional: public base URL of the dashboard, used in email footers.
APP_BASE_URL=http://localhost:3000

# --- Initial seed data (only applied when the tables are empty) --------------
# These values are inserted into the DATABASE on first run. Afterwards
# everything is managed from the dashboard - nothing is hardcoded.
SEED_WEBSITE_NAME=FFSP
SEED_WEBSITE_URL=https://ffsp.info
SEED_WEBSITE_INTERVAL=60
SEED_WORKER_NAME=Test Worker
SEED_WORKER_EMAIL=cruecrv9445@gmail.com
